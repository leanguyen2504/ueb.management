# Sao chép thành .env.local khi chạy trên máy. Trên Vercel, khai báo trong
# Project Settings -> Environment Variables. Không commit file chứa giá trị thật.

# --- Bắt buộc ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bí mật, chỉ dùng ở máy chủ
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Phân cách bằng dấu phẩy
ALLOWED_EMAIL_DOMAINS=vnu.edu.vn
# Chỉ có tác dụng khi hệ thống chưa có quản trị
BOOTSTRAP_ADMIN_EMAIL=

# --- Các giai đoạn sau (để trống cho tới khi được cấp quyền) ---
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
FEATURE_EMAIL=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
FEATURE_GOOGLE_CALENDAR=false
# Lịch Google dùng chung (xem docs/google-calendar.md). Bí mật: dán nguyên nội dung file khóa .json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Chỉ dùng khi lịch để công khai và không có tài khoản dịch vụ
GOOGLE_CALENDAR_API_KEY=
FEATURE_GOOGLE_DRIVE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
GOOGLE_DRIVE_TARGET_FOLDER_ID=
# Jira của trường (xem docs/jira.md). Ví dụ http://<địa chỉ máy chủ Jira>:8080
JIRA_BASE_URL=
# true: máy chủ web tự đọc Jira bằng Personal Access Token của từng người (chỉ khi Jira mở ra Internet).
# Nút "Đồng bộ Jira" bấm trên trang Jira không cần biến này.
FEATURE_JIRA=false
# Tên trường "giờ quy đổi" trên Jira, nếu tên không chứa chữ "quy đổi"
JIRA_CONVERTED_HOURS_FIELD=
